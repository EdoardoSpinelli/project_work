# Nome del modello usato per la chat (es. llama3, llama3.1, mistral, qwen2.5)
OLLAMA_MODEL="llama3"

# Nome del modello usato per creare i vettori/embedding (es. nomic-embed-text, bge-m3)
OLLAMA_EMBED_MODEL="nomic-embed-text"

# URL di Ollama (se gira in locale puoi lasciarlo così o ometterlo)
OLLAMA_BASE_URL="http://localhost:11434"
